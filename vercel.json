{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/openai/(.*)", "dest": "/api/proxy?service=openai&path=$1" },
    { "src": "/api/notion/(.*)", "dest": "/api/proxy?service=notion&path=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
